# ─────────────────────────────────────────────────────────────────────────────
# NBA EDGE — ustawienia. Skopiuj ten plik jako .env.local i uzupełnij, co chcesz.
# Aplikacja działa BEZ żadnych kluczy (dane NBA i kursy DraftKings z ESPN są darmowe).
# NIGDY nie udostępniaj pliku .env.local ani nie wrzucaj go na GitHub — są w nim Twoje klucze.
# ─────────────────────────────────────────────────────────────────────────────

# Kursy polskich bukmacherów (Superbet, Fortuna…) — OPCJONALNIE.
# Załóż własne konto na https://oddspapi.io (jest darmowy plan) i wklej tu swój klucz API.
ODDSPAPI_KEY=

# Których bukmacherów pobierać (nazwa_w_OddsPapi:nazwa_w_aplikacji, po przecinku).
# Darmowy plan zwykle obejmuje superbet.pl i efortuna.pl. Inne: betclic.pl, sts.pl, iforbet.pl.
ODDSPAPI_BOOKMAKERS=superbet.pl:superbet,efortuna.pl:fortuna

# Własny dzienny limit zapytań do OddsPapi (0 = bez limitu). Kursy pobierają się tylko po kliknięciu
# „Pobierz kursy” na stronie „Polskie kursy” (koszt ≈ 1 + liczba meczów).
ODDSPAPI_DAILY_LIMIT=0

# Automatyczne pobieranie kursów co N minut (0 = wyłączone; włącz tylko, jeśli Twój plan na to pozwala).
ODDSPAPI_AUTO_REFRESH_MIN=0

# Kursy zagranicznych bukmacherów — OPCJONALNIE (https://the-odds-api.com, darmowo 500 kredytów/mies.).
ODDS_API_KEY=
ODDS_API_REGIONS=us,eu

# Gdzie zapisywać bazę danych (mecze, statystyki, wyniki). Domyślnie folder „data” w projekcie.
DATA_DIR=./data
