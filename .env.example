# Optional. Enables multi-bookmaker odds (line shopping + consensus no-vig) via The Odds API.
# Get a key at https://the-odds-api.com (free tier: 500 credits/month).
ODDS_API_KEY=

# Comma-separated Odds API regions: us, us2, uk, eu, au. "eu" includes Pinnacle (sharp reference).
ODDS_API_REGIONS=us,eu

# Where the SQLite database (cache, box scores, predictions, backtests) lives.
DATA_DIR=./data

# Optional. OddsPapi v4 (https://oddspapi.io, free plan available). Polish slugs: superbet.pl,
# betclic.pl, efortuna.pl (note the "e"), sts.pl, iforbet.pl. Betfan is not covered — enter it manually.
ODDSPAPI_KEY=
# oddspapiSlug:localKey pairs (local keys: superbet, betclic, betfan)
ODDSPAPI_BOOKMAKERS=superbet.pl:superbet,betclic.pl:betclic,efortuna.pl:fortuna
